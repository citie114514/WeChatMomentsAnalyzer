<Page
    x:Class="WeChatMomentsAnalyzer.Views.ScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WeChatMomentsAnalyzer.Views"
    xmlns:vm="using:WeChatMomentsAnalyzer.ViewModels"
    Background="{ThemeResource Md3SurfaceBackgroundColor}">

    <ScrollViewer Padding="32,24,32,24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" Spacing="20">

            <!-- 顶部说明卡片 -->
            <Border Style="{StaticResource Md3ElevatedCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="扫描朋友圈" Style="{ThemeResource Md3HeadlineSmallStyle}"/>
                    <TextBlock TextWrapping="Wrap" Style="{ThemeResource Md3BodyMediumStyle}"
                               Text="本程序通过 UI 自动化控制微信 PC 客户端。开始前请：1) 启动并登录微信；2) 保持微信窗口在前台；3) 在下方填写你的微信昵称（用于识别『你的』朋友圈）。扫描过程中请勿操作鼠标键盘。"/>
                </StackPanel>
            </Border>

            <!-- 配置区 -->
            <Border Style="{StaticResource Md3FilledCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="扫描配置" Style="{ThemeResource Md3TitleLargeStyle}"/>

                    <TextBox x:Name="NicknameBox"
                             Header="我的微信昵称"
                             PlaceholderText="与微信客户端显示完全一致"
                             Text="{x:Bind ViewModel.MyNickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             CornerRadius="{StaticResource Md3ShapeExtraSmallCornerRadius}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <NumberBox Grid.Column="0" Header="最大滚动屏数" Minimum="1" Maximum="500" SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind ViewModel.MaxScrollScreens, Mode=TwoWay}"/>
                        <NumberBox Grid.Column="1" Header="每屏等待(ms)" Minimum="300" Maximum="10000" SmallChange="100" SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind ViewModel.ScrollWaitMs, Mode=TwoWay}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                        <Button Style="{StaticResource Md3FilledButtonStyle}"
                                Command="{x:Bind ViewModel.StartScanCommand}"
                                IsEnabled="{x:Bind ViewModel.IsScanning, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                <TextBlock Text="开始扫描"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Md3OutlinedButtonStyle}"
                                Command="{x:Bind ViewModel.CancelScanCommand}"
                                IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay}">
                            <TextBlock Text="取消"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 联系人头像库 -->
            <Border Style="{StaticResource Md3FilledCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="联系人头像库" Style="{ThemeResource Md3TitleLargeStyle}"/>
                    <TextBlock TextWrapping="Wrap" Style="{ThemeResource Md3BodyMediumStyle}"
                               Text="扫描微信通讯录，读取好友昵称并截取头像建立头像库。扫描朋友圈时可按头像匹配识别点赞人昵称，显著提升按好友查询与排行榜的数据准确率。建议先扫描联系人再扫描朋友圈。"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                        <Button Style="{StaticResource Md3OutlinedButtonStyle}"
                                Command="{x:Bind ViewModel.ScanContactsCommand}"
                                IsEnabled="{x:Bind ViewModel.IsScanningContacts, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE748;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                <TextBlock Text="扫描联系人"/>
                            </StackPanel>
                        </Button>
                        <Border Background="{ThemeResource Md3SecondaryContainerBrush}"
                                CornerRadius="{StaticResource Md3ShapeMediumCornerRadius}" Padding="16,8">
                            <StackPanel>
                                <TextBlock Text="已保存联系人" Style="{ThemeResource Md3LabelMediumStyle}"/>
                                <TextBlock Text="{x:Bind ViewModel.ContactCount, Mode=OneWay}" Style="{ThemeResource Md3HeadlineSmallStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 进度区 -->
            <Border Style="{StaticResource Md3FilledCardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="扫描进度" Style="{ThemeResource Md3TitleMediumStyle}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                   HorizontalAlignment="Right" Style="{ThemeResource Md3BodySmallStyle}"/>
                    </Grid>
                    <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Maximum="100"
                                 CornerRadius="{StaticResource Md3ShapeFullCornerRadius}"/>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{ThemeResource Md3PrimaryContainerBrush}"
                                CornerRadius="{StaticResource Md3ShapeMediumCornerRadius}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="已保存朋友圈" Style="{ThemeResource Md3LabelMediumStyle}"/>
                                <TextBlock Text="{x:Bind ViewModel.MomentCount, Mode=OneWay}" Style="{ThemeResource Md3HeadlineMediumStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{ThemeResource Md3TertiaryContainerBrush}"
                                CornerRadius="{StaticResource Md3ShapeMediumCornerRadius}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="已保存点赞" Style="{ThemeResource Md3LabelMediumStyle}"/>
                                <TextBlock Text="{x:Bind ViewModel.LikeCount, Mode=OneWay}" Style="{ThemeResource Md3HeadlineMediumStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 日志区 -->
            <Border Style="{StaticResource Md3FilledCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="运行日志" Style="{ThemeResource Md3TitleMediumStyle}"/>
                    <Border Background="{ThemeResource Md3SurfaceContainerHighBrush}"
                            CornerRadius="{StaticResource Md3ShapeSmallCornerRadius}" Padding="12" Height="220">
                        <ScrollViewer>
                            <TextBlock Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
                                       FontFamily="Consolas" TextWrapping="Wrap" Style="{ThemeResource Md3BodySmallStyle}"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
