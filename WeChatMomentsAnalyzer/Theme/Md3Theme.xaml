<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Material Design 3 配色（基于 M3 默认 baseline 配色 + 自定义主色蓝紫） ===== -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- Light 主题 -->
        <ResourceDictionary x:Key="Light">
            <!-- Primary -->
            <Color x:Key="Md3PrimaryColor">#4F6ACD</Color>
            <Color x:Key="Md3OnPrimaryColor">#FFFFFF</Color>
            <Color x:Key="Md3PrimaryContainerColor">#DBE1FF</Color>
            <Color x:Key="Md3OnPrimaryContainerColor">#001551</Color>
            <!-- Secondary -->
            <Color x:Key="Md3SecondaryColor">#5B5D72</Color>
            <Color x:Key="Md3OnSecondaryColor">#FFFFFF</Color>
            <Color x:Key="Md3SecondaryContainerColor">#E0E1F9</Color>
            <Color x:Key="Md3OnSecondaryContainerColor">#181A2C</Color>
            <!-- Tertiary -->
            <Color x:Key="Md3TertiaryColor">#77536D</Color>
            <Color x:Key="Md3OnTertiaryColor">#FFFFFF</Color>
            <Color x:Key="Md3TertiaryContainerColor">#FFD8EE</Color>
            <Color x:Key="Md3OnTertiaryContainerColor">#2D1228</Color>
            <!-- Error -->
            <Color x:Key="Md3ErrorColor">#BA1A1A</Color>
            <Color x:Key="Md3OnErrorColor">#FFFFFF</Color>
            <Color x:Key="Md3ErrorContainerColor">#FFDAD6</Color>
            <Color x:Key="Md3OnErrorContainerColor">#410002</Color>
            <!-- Surface -->
            <Color x:Key="Md3SurfaceColor">#FDF8FF</Color>
            <Color x:Key="Md3OnSurfaceColor">#1B1B21</Color>
            <Color x:Key="Md3SurfaceVariantColor">#E3E1EC</Color>
            <Color x:Key="Md3OnSurfaceVariantColor">#46464F</Color>
            <Color x:Key="Md3SurfaceContainerLowColor">#F4F1FA</Color>
            <Color x:Key="Md3SurfaceContainerColor">#EEEBF4</Color>
            <Color x:Key="Md3SurfaceContainerHighColor">#E8E6EE</Color>
            <Color x:Key="Md3SurfaceContainerHighestColor">#E2E2E9</Color>
            <!-- Outline -->
            <Color x:Key="Md3OutlineColor">#777680</Color>
            <Color x:Key="Md3OutlineVariantColor">#C6C5D0</Color>
            <!-- Background -->
            <Color x:Key="Md3BackgroundColor">#FDF8FF</Color>
            <Color x:Key="Md3OnBackgroundColor">#1B1B21</Color>
            <!-- Inverse -->
            <Color x:Key="Md3InverseSurfaceColor">#303036</Color>
            <Color x:Key="Md3InverseOnSurfaceColor">#F3EFF7</Color>
            <Color x:Key="Md3InversePrimaryColor">#B7C5FF</Color>
        </ResourceDictionary>

        <!-- Dark 主题 -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="Md3PrimaryColor">#B7C5FF</Color>
            <Color x:Key="Md3OnPrimaryColor">#00277A</Color>
            <Color x:Key="Md3PrimaryContainerColor">#333F94</Color>
            <Color x:Key="Md3OnPrimaryContainerColor">#DBE1FF</Color>

            <Color x:Key="Md3SecondaryColor">#C4C5DD</Color>
            <Color x:Key="Md3OnSecondaryColor">#2D3045</Color>
            <Color x:Key="Md3SecondaryContainerColor">#43465C</Color>
            <Color x:Key="Md3OnSecondaryContainerColor">#E0E1F9</Color>

            <Color x:Key="Md3TertiaryColor">#E6B9D3</Color>
            <Color x:Key="Md3OnTertiaryColor">#46263E</Color>
            <Color x:Key="Md3TertiaryContainerColor">#5D3C55</Color>
            <Color x:Key="Md3OnTertiaryContainerColor">#FFD8EE</Color>

            <Color x:Key="Md3ErrorColor">#FFB4AB</Color>
            <Color x:Key="Md3OnErrorColor">#690005</Color>
            <Color x:Key="Md3ErrorContainerColor">#93000A</Color>
            <Color x:Key="Md3OnErrorContainerColor">#FFDAD6</Color>

            <Color x:Key="Md3SurfaceColor">#131318</Color>
            <Color x:Key="Md3OnSurfaceColor">#E4E1E9</Color>
            <Color x:Key="Md3SurfaceVariantColor">#46464F</Color>
            <Color x:Key="Md3OnSurfaceVariantColor">#C6C5D0</Color>
            <Color x:Key="Md3SurfaceContainerLowColor">#1B1B21</Color>
            <Color x:Key="Md3SurfaceContainerColor">#1F1F25</Color>
            <Color x:Key="Md3SurfaceContainerHighColor">#2A2930</Color>
            <Color x:Key="Md3SurfaceContainerHighestColor">#35343B</Color>

            <Color x:Key="Md3OutlineColor">#90909A</Color>
            <Color x:Key="Md3OutlineVariantColor">#46464F</Color>

            <Color x:Key="Md3BackgroundColor">#131318</Color>
            <Color x:Key="Md3OnBackgroundColor">#E4E1E9</Color>

            <Color x:Key="Md3InverseSurfaceColor">#E4E1E9</Color>
            <Color x:Key="Md3InverseOnSurfaceColor">#131318</Color>
            <Color x:Key="Md3InversePrimaryColor">#4F6ACD</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ===== Brush 资源映射 ===== -->
    <SolidColorBrush x:Key="Md3PrimaryBrush" Color="{ThemeResource Md3PrimaryColor}" />
    <SolidColorBrush x:Key="Md3OnPrimaryBrush" Color="{ThemeResource Md3OnPrimaryColor}" />
    <SolidColorBrush x:Key="Md3PrimaryContainerBrush" Color="{ThemeResource Md3PrimaryContainerColor}" />
    <SolidColorBrush x:Key="Md3OnPrimaryContainerBrush" Color="{ThemeResource Md3OnPrimaryContainerColor}" />

    <SolidColorBrush x:Key="Md3SecondaryBrush" Color="{ThemeResource Md3SecondaryColor}" />
    <SolidColorBrush x:Key="Md3OnSecondaryBrush" Color="{ThemeResource Md3OnSecondaryColor}" />
    <SolidColorBrush x:Key="Md3SecondaryContainerBrush" Color="{ThemeResource Md3SecondaryContainerColor}" />
    <SolidColorBrush x:Key="Md3OnSecondaryContainerBrush" Color="{ThemeResource Md3OnSecondaryContainerColor}" />

    <SolidColorBrush x:Key="Md3TertiaryBrush" Color="{ThemeResource Md3TertiaryColor}" />
    <SolidColorBrush x:Key="Md3TertiaryContainerBrush" Color="{ThemeResource Md3TertiaryContainerColor}" />

    <SolidColorBrush x:Key="Md3ErrorBrush" Color="{ThemeResource Md3ErrorColor}" />
    <SolidColorBrush x:Key="Md3ErrorContainerBrush" Color="{ThemeResource Md3ErrorContainerColor}" />

    <SolidColorBrush x:Key="Md3SurfaceBrush" Color="{ThemeResource Md3SurfaceColor}" />
    <SolidColorBrush x:Key="Md3OnSurfaceBrush" Color="{ThemeResource Md3OnSurfaceColor}" />
    <SolidColorBrush x:Key="Md3SurfaceVariantBrush" Color="{ThemeResource Md3SurfaceVariantColor}" />
    <SolidColorBrush x:Key="Md3OnSurfaceVariantBrush" Color="{ThemeResource Md3OnSurfaceVariantColor}" />
    <SolidColorBrush x:Key="Md3SurfaceContainerLowBrush" Color="{ThemeResource Md3SurfaceContainerLowColor}" />
    <SolidColorBrush x:Key="Md3SurfaceContainerBrush" Color="{ThemeResource Md3SurfaceContainerColor}" />
    <SolidColorBrush x:Key="Md3SurfaceContainerHighBrush" Color="{ThemeResource Md3SurfaceContainerHighColor}" />
    <SolidColorBrush x:Key="Md3SurfaceContainerHighestBrush" Color="{ThemeResource Md3SurfaceContainerHighestColor}" />

    <SolidColorBrush x:Key="Md3OutlineBrush" Color="{ThemeResource Md3OutlineColor}" />
    <SolidColorBrush x:Key="Md3OutlineVariantBrush" Color="{ThemeResource Md3OutlineVariantColor}" />

    <SolidColorBrush x:Key="Md3SurfaceBackgroundColor" Color="{ThemeResource Md3BackgroundColor}" />
    <SolidColorBrush x:Key="Md3OnBackgroundBrush" Color="{ThemeResource Md3OnBackgroundColor}" />

    <!-- ===== M3 Type Scale（基于 WinUI TextStyle） ===== -->
    <Style x:Key="Md3DisplayLargeStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="57"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{ThemeResource Md3OnSurfaceBrush}"/>
    </Style>
    <Style x:Key="Md3DisplayMediumStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="45"/>
        <Setter Property="Foreground" Value="{ThemeResource Md3OnSurfaceBrush}"/>
    </Style>
    <Style x:Key="Md3DisplaySmallStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="Foreground" Value="{ThemeResource Md3OnSurfaceBrush}"/>
    </Style>
    <Style x:Key="Md3HeadlineLargeStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{ThemeResource Md3OnSurfaceBrush}"/>
    </Style>
    <Style x:Key="Md3HeadlineMediumStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="Foreground" Value="{ThemeResource Md3OnSurfaceBrush}"/>
    </Style>
    <Style x:Key="Md3HeadlineSmallStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource Md3OnSurfaceBrush}"/>
    </Style>
    <Style x:Key="Md3TitleLargeStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource Md3OnSurfaceBrush}"/>
    </Style>
    <Style x:Key="Md3TitleMediumStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource Md3OnSurfaceBrush}"/>
    </Style>
    <Style x:Key="Md3TitleSmallStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource Md3OnSurfaceBrush}"/>
    </Style>
    <Style x:Key="Md3BodyLargeStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{ThemeResource Md3OnSurfaceBrush}"/>
    </Style>
    <Style x:Key="Md3BodyMediumStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{ThemeResource Md3OnSurfaceVariantBrush}"/>
    </Style>
    <Style x:Key="Md3BodySmallStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource Md3OnSurfaceVariantBrush}"/>
    </Style>
    <Style x:Key="Md3LabelLargeStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource Md3OnSurfaceBrush}"/>
    </Style>
    <Style x:Key="Md3LabelMediumStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource Md3OnSurfaceVariantBrush}"/>
    </Style>

    <!-- ===== M3 形状 CornerRadius ===== -->
    <CornerRadius x:Key="Md3ShapeNoneCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="Md3ShapeExtraSmallCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="Md3ShapeSmallCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="Md3ShapeMediumCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="Md3ShapeLargeCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="Md3ShapeExtraLargeCornerRadius">28</CornerRadius>
    <CornerRadius x:Key="Md3ShapeFullCornerRadius">999</CornerRadius>

    <!-- ===== M3 StateLayer 不透明度 ===== -->
    <x:Double x:Key="Md3StateLayerHoverOpacity">0.08</x:Double>
    <x:Double x:Key="Md3StateLayerFocusOpacity">0.10</x:Double>
    <x:Double x:Key="Md3StateLayerPressedOpacity">0.10</x:Double>

    <!-- ===== 卡片样式（Filled Card） ===== -->
    <Style x:Key="Md3FilledCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Md3SurfaceContainerHighestBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Md3ShapeMediumCornerRadius}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="Md3ElevatedCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Md3SurfaceContainerLowBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Md3ShapeMediumCornerRadius}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BorderBrush" Value="{ThemeResource Md3OutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ===== M3 Filled Button 样式（覆盖 Button） ===== -->
    <Style x:Key="Md3FilledButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource Md3PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource Md3OnPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Md3ShapeFullCornerRadius}"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Md3OutlinedButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource Md3PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource Md3OutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Md3ShapeFullCornerRadius}"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="24,0"/>
    </Style>

    <Style x:Key="Md3TextButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource Md3PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Md3ShapeFullCornerRadius}"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <!-- ===== M3 顶部应用栏 ===== -->
    <Style x:Key="Md3TopAppBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Md3SurfaceBrush}"/>
        <Setter Property="Padding" Value="16,8"/>
    </Style>

    <!-- ===== M3 Chip（使用 ToggleButton 模拟 Filter Chip） ===== -->
    <Style x:Key="Md3FilterChipStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource Md3SurfaceVariantBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource Md3OnSurfaceVariantBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Md3ShapeSmallCornerRadius}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>
</ResourceDictionary>
