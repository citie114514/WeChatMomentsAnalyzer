<Application
    x:Class="WeChatMomentsAnalyzer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WeChatMomentsAnalyzer"
    xmlns:views="using:WeChatMomentsAnalyzer.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Theme/Md3Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <views:DateTimeConverter x:Key="DateTimeConverter"/>
            <views:LikersToStringConverter x:Key="LikersToStringConverter"/>
            <views:BoolNegationConverter x:Key="BoolNegationConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
