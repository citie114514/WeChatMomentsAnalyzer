<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WeChatMomentsAnalyzer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64</Platforms>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseXamlCompilerExecutable>false</UseXamlCompilerExecutable>
    <!-- 框架依赖(去掉 SelfContained/WindowsAppSDKSelfContained)：使用系统已装的 Windows App Runtime 1.4 框架。
         Program.cs 手动 MddBootstrapInitialize 绑定系统框架是未打包应用的标准方式。
         自包含构建下(无论手动/自动 bootstrap)Microsoft.UI.Xaml.dll 都会启动 fail-fast(0xC000027B)，故放弃自包含。
         另设 AppxGenerateProjectPriFile=true 确保未打包构建生成 PRI 资源索引。 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <AppxGenerateProjectPriFile>true</AppxGenerateProjectPriFile>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.4.240211002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.10.0.20241107" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.10.0.20241107" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="**\*.xaml.cs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
